<Window x:Class="RobotPlanet.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robot Planet"
        Height="720" Width="1000"
        MinHeight="650" MinWidth="850">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="ROBOT PLANET"
                           FontSize="26" FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Repository"/>

                <ComboBox ItemsSource="{Binding Groups}"
                          SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Margin="0,5,0,15"/>

                <TextBlock Text="Robot name"/>

                <TextBox Text="{Binding NewRobotName,
                                UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,10"/>

                <Button Content="Add Robot"
                        Command="{Binding AddCommand}"
                        Padding="8" Margin="0,0,0,20"/>

                <TextBlock Text="Search by name"/>

                <TextBox Text="{Binding SearchText,
                                UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Robots — sorted by name"
                           FontWeight="Bold" Margin="0,0,0,5"/>
            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Robots}"
                     SelectedItem="{Binding SelectedRobot, Mode=TwoWay}"/>

            <Button Grid.Row="2"
                    Content="Remove Selected"
                    Command="{Binding RemoveCommand}"
                    Padding="8" Margin="0,10,0,0"/>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Selected robot"
                           FontSize="20" FontWeight="Bold"/>

                <TextBlock Text="{Binding SelectedRobotInfo}"
                           FontSize="18" Margin="0,10"
                           TextWrapping="Wrap"/>

                <TextBlock Text="{Binding SelectedEnergy,
                                  StringFormat='Energy: {0}%'}"/>

                <ProgressBar Value="{Binding SelectedEnergy, Mode=OneWay}"
                             Minimum="0" Maximum="100"
                             Height="25" Margin="0,5,0,10"/>

                <TextBlock Text="{Binding SelectedReactionCount,
                                  StringFormat='Reactions: {0}'}"
                           Margin="0,0,0,10"/>

                <WrapPanel Margin="0,0,0,15">
                    <Button Content="Work"
                            Command="{Binding WorkCommand}"
                            Padding="12,8" Margin="0,0,8,8"/>

                    <Button Content="Crazy Action"
                            Command="{Binding CrazyActionCommand}"
                            Padding="12,8" Margin="0,0,8,8"/>

                    <Button Content="Charge +20"
                            Command="{Binding ChargeCommand}"
                            Padding="12,8" Margin="0,0,8,8"/>

                    <Button Content="Repair"
                            Command="{Binding RepairCommand}"
                            Padding="12,8" Margin="0,0,8,8"/>
                </WrapPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Summary — all repositories"
                           FontWeight="Bold"/>

                <TextBlock Text="{Binding Summary}"
                           Margin="0,5,0,15"/>

                <TextBlock Text="LOG" FontWeight="Bold"/>
            </StackPanel>

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Log}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   Margin="0,3"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>